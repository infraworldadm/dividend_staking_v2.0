NEXT_PUBLIC_CHAIN_ID=15324
NEXT_PUBLIC_CHAIN_NAME=INFRA Chain
NEXT_PUBLIC_RPC_URL=https://uat.infraworld.org/
NEXT_PUBLIC_EXPLORER_URL=https://uat.scan.infraworld.org/
NEXT_PUBLIC_NATIVE_NAME=ReAED
NEXT_PUBLIC_NATIVE_SYMBOL=ReAED
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
# InfraStakingPool proxy address (printed by contracts/script/Deploy.s.sol)
NEXT_PUBLIC_STAKING_POOL_ADDRESS=0xeEb712B20b9d4AEF535a781e1222FD1174fFa919
# Optional: first month shown in cycle history (YYYY-MM)
NEXT_PUBLIC_POOL_START_MONTH=

# ── Admin login (server only; never NEXT_PUBLIC) ──
# operators as user:password pairs, comma-separated
ADMIN_USERS=
# 32+ random characters, signs the login cookie
ADMIN_SESSION_SECRET=

# ── Daily keeper (Vercel Cron → /api/cron/keeper) ──
CRON_SECRET=
# NEW gas-only wallet (no rights). NEVER the owner key.
KEEPER_PRIVATE_KEY=

# INFRA Wallet app deep link prefix for WalletConnect (from wallet team), e.g. infrawallet://wc?uri=
NEXT_PUBLIC_INFRA_WALLET_SCHEME=
