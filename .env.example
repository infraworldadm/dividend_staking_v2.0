# ─────────────────────────────────────────────────────────────
# INFRA Staking — environment variables
# Full reference: docs/OPERATIONS.md#environment-variables
# NEXT_PUBLIC_* values are exposed to the browser. Others are server-only.
# ─────────────────────────────────────────────────────────────

# ── Network (defaults = INFRA UAT) ──
NEXT_PUBLIC_CHAIN_ID=15324
NEXT_PUBLIC_CHAIN_NAME=INFRA Chain
NEXT_PUBLIC_RPC_URL=https://uat.infraworld.org/
NEXT_PUBLIC_EXPLORER_URL=https://uat.scan.infraworld.org/
NEXT_PUBLIC_NATIVE_NAME=ReAED
NEXT_PUBLIC_NATIVE_SYMBOL=ReAED

# ── Contracts (addresses live in deployments/uat.json) ──
# Staking proxy. Set ONLY after the upgrade tx is confirmed — it switches staking on.
NEXT_PUBLIC_STAKING_POOL_ADDRESS=
# Optional override of the dividend pool (local testing)
NEXT_PUBLIC_DIVIDEND_POOL_ADDRESS=

# ── Wallets ──
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
# INFRA Wallet app deep-link prefix for WalletConnect, e.g. infrawallet://wc?uri=
NEXT_PUBLIC_INFRA_WALLET_SCHEME=

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://dividend-staking-v2-0.vercel.app
# First month shown in cycle history (YYYY-MM)
NEXT_PUBLIC_POOL_START_MONTH=

# ── Admin login (server only) ──
# Operators as user:password pairs, comma-separated
ADMIN_USERS=
# 32+ random characters; signs the session cookie
ADMIN_SESSION_SECRET=

# ── Daily keeper (Vercel Cron → /api/cron/keeper) ──
CRON_SECRET=
# NEW gas-only wallet with no rights. NEVER the owner key.
KEEPER_PRIVATE_KEY=
